# DATABASE_URL: Prisma connection string with pooling (usually port 6543 for Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection string for migrations (usually port 5432 for Supabase)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET="PAYBEE_SUPER_SECRET_KEY_CHANGE_ME"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# PORT: The port your Express server will run on
PORT=5000

# FRONTEND_URL: The URL of your React SPA.
FRONTEND_URL="https://app.paybee.live"
